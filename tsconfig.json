{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "e2e/**/*", "scripts/**/*", "*.config.*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  }
}
