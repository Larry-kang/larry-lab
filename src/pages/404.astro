---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../config/site';
---

<BaseLayout title="找不到頁面 (404)" description="抱歉，找不到您欲前往的 Larry Lab 網頁。">
  <section class="panel" style="text-align: center; padding: 48px 20px;">
    <h1 style="font-size: 3rem; margin-bottom: 0.2em; color: var(--accent);">404</h1>
    <p class="lead" style="margin: 0 auto 24px;">找不到您請求的頁面</p>
    <p class="prose" style="margin: 0 auto 32px;">
      該網址可能已變更、被移除，或輸入時發生筆誤。您可以返回首頁，或直接使用下方推薦的實用試算工具。
    </p>
    <p>
      <a class="btn primary" href="/">返回 Larry Lab 首頁</a>
      <a class="btn" href="/tools/" style="margin-left: 12px;">查看所有工具</a>
    </p>
  </section>

  <section class="panel">
    <h2>熱門試算工具</h2>
    <ul class="card-grid">
      {
        tools.slice(0, 3).map((t) => (
          <li>
            <a class="tool-card" href={t.path}>
              <h3>{t.name}</h3>
              <p>{t.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
