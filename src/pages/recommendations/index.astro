---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecommendationPanel from '../../components/RecommendationPanel.astro';
import { site } from '../../config/site';
---

<BaseLayout title="推薦總覽" description="整理作者提供的數位銀行、證券開戶與加密資產服務推薦連結與推薦碼，並附完整利益揭露說明。" nav="recommendations">
  <h1>推薦總覽</h1>
  <p class="lead">
    以下整理作者提供的數位銀行、證券與加密資產服務推薦連結及邀請碼。所有試算工具皆獨立運作，不受推薦資訊或排序影響。
  </p>

  <div class="panel">
    <RecommendationPanel variant="full" />
  </div>

  <section id="disclosure" aria-labelledby="disclosure-heading" class="panel">
    <h2 id="disclosure-heading">利益揭露與使用說明</h2>
    <div class="prose">
      <p>
        <strong>利益揭露：</strong>
        {site.referralNotice}
      </p>
      <p>
        <strong>查核與狀態說明：</strong>
        各卡片分別標示作者提供日期、連結檢查日期與優惠檢查狀態。僅提供推薦碼的項目可點擊複製並於申請時自行填入；外部連結若因平台限制無法自動確認，將標示為「連結待確認」並暫停外連按鈕。
      </p>
      <p>
        <strong>風險與條件提醒：</strong>
        金融開戶、借貸與虛擬資產服務均具相應風險與資格限制，實際活動內容、費率、開戶條件與服務範圍請以各平台官方最新公告為準。
      </p>
    </div>
  </section>
</BaseLayout>
