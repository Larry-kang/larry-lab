---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecommendationPanel from '../../components/RecommendationPanel.astro';
import { site } from '../../config/site';
---

<BaseLayout title="推薦總覽" description="整理數位銀行、證券開戶、台灣與國際加密資產服務推薦連結及邀請碼，並附利益揭露說明。" nav="recommendations">
  <h1>推薦總覽</h1>
  <p class="lead">
    以下整理數位銀行、證券開戶、台灣與國際加密資產服務的推薦連結與邀請碼。所有試算工具皆獨立運作，不受推薦資訊影響。
  </p>

  <div class="panel">
    <RecommendationPanel variant="full" />
  </div>

  <section id="disclosure" aria-labelledby="disclosure-heading" class="panel">
    <h2 id="disclosure-heading">利益揭露與使用說明</h2>
    <div class="prose">
      <p>
        <strong>利益揭露：</strong>
        {site.referralNotice}
      </p>
      <p>
        <strong>使用方式：</strong>
        點擊「前往」按鈕將另開新分頁前往該平台官方申辦或註冊頁面；標示推薦碼的項目可點擊「複製推薦碼」，於開戶申請流程中自行填入。
      </p>
      <p>
        <strong>風險與條件提醒：</strong>
        金融開戶、借貸與虛擬資產服務均具相應風險與資格限制，實際活動內容、費率、開戶條件與服務範圍請以各平台官方最新公告為準。
      </p>
    </div>
  </section>
</BaseLayout>
