---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../config/site';

const loanTools = tools.filter((t) => t.category === '買房與借貸');
const investTools = tools.filter((t) => t.category === '投資與退休');
---

<BaseLayout title="工具總覽" description="Larry Lab 提供的財金與生活實用試算工具一覽，涵蓋買房、信貸、質押、退休與投資組合。" nav="tools">
  <h1>工具總覽</h1>
  <p class="lead">
    全站工具皆採訪客手動輸入假設、瀏覽器本機計算。未計入的費用、稅負與政策限制均有清楚註記，不作為個人化財務建議。
  </p>

  <section aria-labelledby="loan-tools-heading" class="panel">
    <h2 id="loan-tools-heading">買房與借貸</h2>
    <p class="prose">
      評估購屋負擔、利息支出與擔保品風險，協助在不同貸款條件與市場情境下建立清晰的財務安全邊際。
    </p>
    <ul class="card-grid">
      {
        loanTools.map((t) => (
          <li>
            <a class="tool-card" href={t.path}>
              <h3>{t.name}</h3>
              <p>{t.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="invest-tools-heading" class="panel">
    <h2 id="invest-tools-heading">投資與退休</h2>
    <p class="prose">
      規劃長期資產成長、退休現金流缺口與多資產再平衡配置，避免因單一樂觀假設而低估未來風險。
    </p>
    <ul class="card-grid">
      {
        investTools.map((t) => (
          <li>
            <a class="tool-card" href={t.path}>
              <h3>{t.name}</h3>
              <p>{t.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="panel">
    <h2>使用說明與限制</h2>
    <ul class="prose">
      <li><strong>本機運算</strong>：所有數字均在你的裝置計算，重新整理前可選擇記住設定，或匯出為本機 JSON 檔案。</li>
      <li><strong>計算假設</strong>：各工具詳細公式請參考<a href="/methodology/">計算方法</a>說明頁。</li>
      <li><strong>隱私保護</strong>：無第三方追蹤程式碼，詳見<a href="/privacy/">隱私說明</a>。</li>
    </ul>
  </section>
</BaseLayout>
