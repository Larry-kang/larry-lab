---
import '../styles/global.css';
import RecommendationPanel from '../components/RecommendationPanel.astro';
import { navItems, site } from '../config/site';
import { serializeJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Key from navItems for the current page; omit for pages outside the main navigation. */
  nav?: (typeof navItems)[number]['key'];
  /** Show a "tool category" label above the page content. */
  toolCategory?: string;
  structuredData?: unknown;
}
const { title, description, nav, toolCategory, structuredData } = Astro.props;
const fullTitle = title === site.name ? `${site.name}｜${site.tagline}` : `${title}｜${site.name}`;
const isNotFound = /^\/404(?:\.html|\/)?$/.test(Astro.url.pathname);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og-image.png', Astro.site);
const schema = structuredData ?? (Astro.url.pathname === '/' ? { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${Astro.site!.href}#website`, name: site.name, url: Astro.site!.href, description: site.description, inLanguage: 'zh-Hant-TW' } : undefined);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/app-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    {!isNotFound && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}｜${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {schema && <script is:inline type="application/ld+json" set:html={serializeJsonLd(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Larry Lab 首頁">
          <img src="/app-icon.svg" alt="" width="32" height="32" class="brand-logo" decoding="async" />
          <span>Larry Lab</span>
        </a>
        <nav aria-label="主要導覽">
          <ul class="nav-list">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={nav === item.key ? 'page' : undefined}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <div class="layout">
      <main id="main" class="content" tabindex="-1">
        {toolCategory && <p class="eyebrow">{toolCategory}</p>}
        <slot />
        <details class="rec-mobile-wrap" data-testid="rec-mobile">
          <summary>推薦開戶與平台優惠（共 17 項）</summary>
          <RecommendationPanel variant="mobile" />
        </details>
      </main>
      <aside class="rec-aside" aria-label="推薦資訊" data-testid="rec-aside">
        <RecommendationPanel variant="sidebar" />
      </aside>
    </div>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>© Larry Lab · 所有試算皆在瀏覽器本機完成，預設數值均為示範情境。</p>
        <ul class="footer-links">
          <li><a href="/methodology/">計算方法</a></li>
          <li><a href="/privacy/">隱私說明</a></li>
          <li><a href="/recommendations/#disclosure">利益揭露</a></li>
          <li><a href="/recommendations/">推薦總覽</a></li>
        </ul>
      </div>
    </footer>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
