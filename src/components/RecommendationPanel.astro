---
import {
  groupByCategory,
  hasUsableReferralLink,
  isOfferActive,
  publicRecommendations,
  sidebarRecommendations,
  validateRecommendations,
} from '../lib/recommendations';
import recommendationsFile from '../content/recommendations.json';
import { site } from '../config/site';
import { buildIntroMap } from '../lib/articles';
import { loadArticles, toMeta } from '../lib/article-collection';

interface Props {
  variant: 'sidebar' | 'mobile' | 'full';
}
const { variant } = Astro.props;

const allValidated = validateRecommendations(recommendationsFile);
const totalPublicCount = publicRecommendations(allValidated).length;
const items = variant === 'full' ? publicRecommendations(allValidated) : sidebarRecommendations(allValidated);
const now = new Date();
const groups = groupByCategory(items);
const prefix = variant;
const introMap = variant === 'full' ? buildIntroMap((await loadArticles()).map(toMeta)) : {};
---

<div class={`rec rec-${variant}`} data-rec-variant={variant}>
  {variant === 'sidebar' && <h2 class="rec-title" id={`rec-title-${prefix}`}>推薦開戶與平台</h2>}
  {
    items.length === 0 ? (
      <div class="rec-empty" data-testid="rec-empty">
        <p>目前尚無啟用的推薦項目。</p>
      </div>
    ) : variant === 'full' ? (
      groups.map((group) => (
        <section aria-label={group.category} class="rec-group">
          <h2 class="rec-category">{group.category}（{group.items.length}）</h2>
          <ul class="rec-list">
            {group.items.map((item) => {
              const isUnknown = item.linkStatus === 'UNKNOWN' || !item.enabled;
              const canLink = hasUsableReferralLink(item);

              return (
                <li class={`rec-card${isUnknown ? ' rec-card-pending' : ''}`} data-rec-id={item.id} data-rec-status={item.linkStatus ?? 'VERIFIED'}>
                  <div class="rec-card-head">
                    <div class="rec-brand-row">
                      {item.logo && (
                        <img
                          src={item.logo}
                          alt=""
                          width="40"
                          height="40"
                          class="rec-logo-lg"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <p class="rec-name">{item.name}</p>
                    </div>
                    {isUnknown && <span class="rec-status-badge" data-testid="rec-status-pending">連結待確認</span>}
                  </div>
                  <p class="rec-desc">{item.shortDescription}</p>
                  {isOfferActive(item, now) && (
                    <p class="rec-offer" data-offer-expires={item.offerExpiresAt ?? ''}>
                      {item.offerText}
                      {item.offerExpiresAt ? `（至 ${item.offerExpiresAt}）` : ''}
                    </p>
                  )}
                  {item.code && (
                    <p class="rec-code">
                      推薦碼：<code data-copy-code={item.code}>{item.code}</code>{' '}
                      <button type="button" class="btn small" data-copy={item.code} aria-label={`複製 ${item.name} 推薦碼 ${item.code}`}>
                        複製推薦碼
                      </button>
                    </p>
                  )}
                  {canLink && item.referralUrl && (
                    <p class="rec-action">
                      <a class="btn small" href={item.referralUrl} target="_blank" rel="sponsored noopener noreferrer">
                        前往 {item.name}（另開新分頁）
                      </a>
                    </p>
                  )}
                  {introMap[item.id] && (
                    <p class="rec-intro">
                      <a href={introMap[item.id]} data-testid="rec-intro-link">閱讀介紹</a>
                    </p>
                  )}
                  {isUnknown && (
                    <p class="rec-pending-note">連結整理中，暫不提供外連按鈕。</p>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    ) : (
      <div class="rec-compact-groups">
        {groups.map((group) => (
          <section aria-label={group.category} class="rec-compact-group">
            <h3 class="rec-compact-cat">{group.category}</h3>
            <ul class="rec-compact-list">
              {group.items.map((item) => {
                const canLink = hasUsableReferralLink(item);
                return (
                  <li class="rec-card rec-compact-item" data-rec-id={item.id}>
                    <div class="rec-compact-main">
                      {item.logo && (
                        <img
                          src={item.logo}
                          alt=""
                          width="28"
                          height="28"
                          class="rec-logo-sm"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      <div class="rec-compact-info">
                        <span class="rec-name">{item.name}</span>
                        {item.code && (
                          <span class="rec-compact-code-wrap">
                            推薦碼 <code data-copy-code={item.code}>{item.code}</code>
                          </span>
                        )}
                      </div>
                    </div>
                    <div class="rec-compact-act">
                      {item.code && (
                        <button
                          type="button"
                          class="btn tiny"
                          data-copy={item.code}
                          aria-label={`複製 ${item.name} 推薦碼 ${item.code}`}
                        >
                          複製
                        </button>
                      )}
                      {canLink && item.referralUrl && (
                        <a
                          class="btn tiny"
                          href={item.referralUrl}
                          target="_blank"
                          rel="sponsored noopener noreferrer"
                          aria-label={`前往 ${item.name}（另開新分頁）`}
                        >
                          前往 ↗
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    )
  }
  <p class="rec-notice">{site.referralNotice}</p>
  {variant !== 'full' && (
    <p class="rec-more">
      <a href="/recommendations/">查看全部 {totalPublicCount} 項推薦與完整介紹 →</a>
    </p>
  )}
</div>
