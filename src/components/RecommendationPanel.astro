---
import {
  groupByCategory,
  hasUsableReferralLink,
  isOfferActive,
  publicRecommendations,
  sidebarRecommendations,
  validateRecommendations,
} from '../lib/recommendations';
import recommendationsFile from '../content/recommendations.json';
import { site } from '../config/site';

interface Props {
  variant: 'sidebar' | 'mobile' | 'full';
}
const { variant } = Astro.props;

const allValidated = validateRecommendations(recommendationsFile);
const totalPublicCount = publicRecommendations(allValidated).length;
const items = variant === 'full' ? publicRecommendations(allValidated) : sidebarRecommendations(allValidated, 3);
const now = new Date();
const groups = groupByCategory(items);
const prefix = variant;
---

<div class={`rec rec-${variant}`} data-rec-variant={variant}>
  {variant !== 'full' && <h2 class="rec-title" id={`rec-title-${prefix}`}>推薦資訊</h2>}
  {
    items.length === 0 ? (
      <div class="rec-empty" data-testid="rec-empty">
        <p>目前尚無啟用的推薦項目。</p>
      </div>
    ) : variant === 'full' ? (
      groups.map((group) => (
        <section aria-label={group.category} class="rec-group">
          <h2 class="rec-category">{group.category}（{group.items.length}）</h2>
          <ul class="rec-list">
            {group.items.map((item) => {
              const isUnknown = item.linkStatus === 'UNKNOWN' || !item.enabled;
              const canLink = hasUsableReferralLink(item);
              const metaParts: string[] = [];
              if (item.providedAt) metaParts.push(`作者提供：${item.providedAt}`);
              if (item.linkCheckedAt) metaParts.push(`連結檢查：${item.linkCheckedAt}`);
              else if (item.linkStatus === 'CODE_ONLY') metaParts.push('連結檢查：僅提供推薦碼');
              else metaParts.push(`資料核對：${item.lastVerifiedAt}`);
              if (item.offerCheckedAt) metaParts.push(`優惠檢查：${item.offerCheckedAt}`);
              else metaParts.push('優惠檢查：依平台公告');

              return (
                <li class={`rec-card${isUnknown ? ' rec-card-pending' : ''}`} data-rec-id={item.id} data-rec-status={item.linkStatus ?? 'VERIFIED'}>
                  <div class="rec-card-head">
                    <p class="rec-name">{item.name}</p>
                    {isUnknown && <span class="rec-status-badge" data-testid="rec-status-pending">連結待確認</span>}
                  </div>
                  <p class="rec-desc">{item.shortDescription}</p>
                  {isOfferActive(item, now) && (
                    <p class="rec-offer" data-offer-expires={item.offerExpiresAt ?? ''}>
                      {item.offerText}
                      {item.offerExpiresAt ? `（至 ${item.offerExpiresAt}）` : ''}
                    </p>
                  )}
                  {item.code && (
                    <p class="rec-code">
                      推薦碼：<code data-copy-code={item.code}>{item.code}</code>{' '}
                      <button type="button" class="btn small" data-copy={item.code} aria-label={`複製 ${item.name} 推薦碼 ${item.code}`}>
                        複製推薦碼
                      </button>
                    </p>
                  )}
                  {canLink && item.referralUrl && (
                    <p class="rec-action">
                      <a class="btn small" href={item.referralUrl} target="_blank" rel="sponsored noopener noreferrer">
                        前往 {item.name}（另開新分頁）
                      </a>
                    </p>
                  )}
                  {isUnknown && (
                    <p class="rec-pending-note">外部連結目前無法自動確認，已暫停外連按鈕。</p>
                  )}
                  <p class="rec-meta">{metaParts.join(' · ')}</p>
                  <p class="rec-meta">{item.disclosure}</p>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    ) : (
      <ul class="rec-list">
        {items.map((item) => {
          const canLink = hasUsableReferralLink(item);
          return (
            <li class="rec-card" data-rec-id={item.id}>
              <div class="rec-card-head">
                <p class="rec-name">{item.name}</p>
                <span class="rec-cat-tag">{item.category}</span>
              </div>
              <p class="rec-desc">{item.shortDescription}</p>
              {item.code && (
                <p class="rec-code">
                  推薦碼：<code data-copy-code={item.code}>{item.code}</code>{' '}
                  <button type="button" class="btn small" data-copy={item.code} aria-label={`複製 ${item.name} 推薦碼 ${item.code}`}>
                    複製推薦碼
                  </button>
                </p>
              )}
              {canLink && item.referralUrl && (
                <p class="rec-action">
                  <a class="btn small" href={item.referralUrl} target="_blank" rel="sponsored noopener noreferrer">
                    前往 {item.name}（另開新分頁）
                  </a>
                </p>
              )}
            </li>
          );
        })}
      </ul>
    )
  }
  <p class="rec-notice">{site.referralNotice}</p>
  {variant !== 'full' && (
    <p class="rec-more">
      <a href="/recommendations/">查看全部 {totalPublicCount} 項推薦與利益揭露 →</a>
    </p>
  )}
</div>
