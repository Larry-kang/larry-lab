---
// Tap/click-to-enlarge for article screenshots marked .image-portrait.
// Native <dialog>: Esc closes, focus is trapped and returned to the trigger image.
---
<script>
  const setup = () => {
    const images = document.querySelectorAll<HTMLImageElement>('.article-body img.image-portrait');
    if (!images.length) return;

    const dialog = document.createElement('dialog');
    dialog.className = 'image-enlarge-overlay';
    dialog.setAttribute('aria-label', '放大圖片');
    dialog.innerHTML = '<button type="button" class="close-btn" aria-label="關閉放大圖片">×</button><img alt="" />';
    document.body.appendChild(dialog);
    const big = dialog.querySelector('img') as HTMLImageElement;
    const closeBtn = dialog.querySelector('button') as HTMLButtonElement;
    let trigger: HTMLElement | null = null;

    const open = (img: HTMLImageElement) => {
      trigger = img;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      dialog.showModal();
      closeBtn.focus();
    };

    images.forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `放大圖片：${img.alt}`);
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(img); }
      });
    });

    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog || e.target === big) dialog.close(); });
    dialog.addEventListener('close', () => { big.removeAttribute('src'); trigger?.focus(); });
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
  else setup();
</script>
