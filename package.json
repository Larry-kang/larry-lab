    "url": "git+https://github.com/Larry-kang/larry-lab.git"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.8",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
