{
  "name": "larry-lab",
  "version": "1.0.0",
  "description": "Larry Lab 公開個人工具網站（Astro 靜態輸出）",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint .",
